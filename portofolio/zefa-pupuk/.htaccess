Options -Indexes
RewriteEngine On
RewriteBase /

# Block akses langsung ke file sensitif
RewriteRule ^config\.php$ - [F,L]
RewriteRule ^database\.sql$ - [F,L]

# Jika file atau folder fisik memang ada, langsung buka file/folder tersebut
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Halaman reseller: /hery -> index.php?slug=hery
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?slug=$1 [QSA,L]
